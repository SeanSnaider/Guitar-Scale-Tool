# Required. API key for the Subconscious streaming SDK, which backs the
# Practice Coach agent. Without it, POST /api/agent fails at request time.
SUBCONSCIOUS_API_KEY=your-key-here

# Port the Express sidecar listens on. Vite proxies /api/agent and /api/tools
# here, so changing this means updating the proxy in frontend/vite.config.ts.
PORT=3001

# Origin allowed by CORS — the Vite dev server.
CORS_ORIGIN=http://localhost:5173

# Base URL the agent uses to call its own tool endpoints. Defaults to
# http://localhost:$PORT; set explicitly when deploying behind a proxy.
TOOL_BASE_URL=http://localhost:3001
